# Vorlage für .env – erzeugen mit:  make secrets
# Platzhalter __…__ werden durch zufällige Werte ersetzt. .env niemals committen.

APP_ENV=development

# Öffentliche Adressen
# Ports auf dem Server (nur 127.0.0.1) – Ziel für den nginx-Reverse-Proxy (infra/nginx/selbstlite.conf)
BIND_ADDRESS=127.0.0.1
FRONTEND_PORT=8310
BACKEND_PORT=8311
DOCUMENSO_PORT=8312
# Nur für lokale Entwicklung mit Caddy (docker compose --profile lokal up -d)
APP_SITE=http://localhost
SIGN_SITE=http://sign.localhost
PORTAL_SITE=http://portal.localhost
# Vollständige Herkunft der App (für Google-Weiterleitung und CSRF-Prüfung), Produktion z. B. https://app.beispiel.de
APP_ORIGIN=http://localhost
# Kundenportal (Produktion z. B. https://portal.beispiel.de)
PORTAL_ORIGIN=http://portal.localhost
DOCUMENSO_PUBLIC_URL=http://sign.localhost

# Mandant (eine UG) – feste ID, wird in allen Datensätzen gespeichert
TENANT_ID=__TENANT_ID__

# ───────── Anmeldung mit Google Workspace (keine Rollen: angemeldet = voller Zugriff) ─────────
# OAuth-Client (Typ „Webanwendung“, Zustimmungsbildschirm „Intern“)
# Weiterleitungs-URI: <APP_ORIGIN>/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Nur Konten dieser Workspace-Domain, z. B. beispiel.de
AUTH_ALLOWED_DOMAIN=
# Optional: nur diese Adressen (kommagetrennt). Leer = alle aktiven Konten der Domain
AUTH_ALLOWED_EMAILS=
# Schlüssel für signierte Anmelde-Cookies
SESSION_SECRET=__SESSION_SECRET__

# ───────── E-Mail (beliebiger Anbieter) ─────────
# MAIL_PROVIDER: google | microsoft | ionos | strato | netcup | hetzner | allinkl | mailbox_org | posteo | gmx | webde |
#                telekom | icloud | fastmail | zoho | smtp (eigener Server) – Server/Ports kommen aus der Voreinstellung
# MAIL_AUTH_MODE:
#   service_account – Google Workspace, Dienstkonto (XOAUTH2, kein Passwort): secrets/google-mail-service-account.json
#   oauth_client    – Microsoft 365 / Exchange Online, App-Registrierung (MS_TENANT_ID, MS_CLIENT_ID, MS_CLIENT_SECRET)
#   app_password    – alle anderen: Passwort bzw. App-Passwort des Postfachs (MAIL_APP_PASSWORD)
# Lokaler Test ohne echten Versand: MAIL_AUTH_MODE=local, MAIL_MAILBOX=buchhaltung@selbstlite.test, SMTP_HOST=mailpit, SMTP_PORT=1025
MAIL_PROVIDER=google
MAIL_AUTH_MODE=service_account
# Postfach, über das versendet wird, z. B. rechnungen@beispiel.de
MAIL_MAILBOX=
MAIL_FROM_NAME=
# Anmeldename, falls abweichend von MAIL_MAILBOX (z. B. bei STRATO/ALL-INKL)
MAIL_USERNAME=
MAIL_APP_PASSWORD=
# Microsoft 365 (Entra ID → App-Registrierungen; Anleitung docs/betrieb.md „E-Mail“)
MS_TENANT_ID=
MS_CLIENT_ID=
MS_CLIENT_SECRET=
# Eigene Server statt Voreinstellung (Pflicht bei netcup, ALL-INKL und MAIL_PROVIDER=smtp)
SMTP_HOST=
SMTP_PORT=
# auto (465 = TLS, sonst STARTTLS) | starttls | ssl
SMTP_SECURITY=auto
IMAP_HOST=
IMAP_PORT=
# Belegeingang per IMAP, z. B. belege@beispiel.de; leer = MAIL_MAILBOX. Verarbeitete Mails wandern in MAIL_PROCESSED_FOLDER
# (bei Google: Label). Tipp: Rechnungen per Regel in einen eigenen Ordner sortieren und MAIL_IMAP_FOLDER darauf setzen.
MAIL_IMAP_MAILBOX=
MAIL_IMAP_FOLDER=INBOX
MAIL_PROCESSED_FOLDER=selbstlite-verarbeitet

# ───────── PostgreSQL ─────────
POSTGRES_SUPERUSER=postgres
POSTGRES_SUPERUSER_PASSWORD=__POSTGRES_SUPERUSER_PASSWORD__
SELBSTLITE_MIGRATOR_PASSWORD=__SELBSTLITE_MIGRATOR_PASSWORD__
SELBSTLITE_APP_PASSWORD=__SELBSTLITE_APP_PASSWORD__
SELBSTLITE_LEDGER_PASSWORD=__SELBSTLITE_LEDGER_PASSWORD__

# Interner Schlüssel Backend → Ledger
LEDGER_INTERNAL_TOKEN=__LEDGER_INTERNAL_TOKEN__

# ───────── Documenso (self-hosted) ─────────
# SMTP für Signatur-Mails (Standard Gmail); z. B. IONOS: DOCUMENSO_SMTP_HOST=smtp.ionos.de
# Microsoft 365 erlaubt kein Passwort-SMTP mehr → SMTP-Relay oder anderes Postfach verwenden
DOCUMENSO_SMTP_HOST=smtp.gmail.com
DOCUMENSO_SMTP_PORT=587
DOCUMENSO_SMTP_SECURE=false
# Vor Produktion Version pinnen, z. B. documenso/documenso:<version>
DOCUMENSO_IMAGE=documenso/documenso:latest
DOCUMENSO_DB_PASSWORD=__DOCUMENSO_DB_PASSWORD__
DOCUMENSO_NEXTAUTH_SECRET=__DOCUMENSO_NEXTAUTH_SECRET__
DOCUMENSO_ENCRYPTION_KEY=__DOCUMENSO_ENCRYPTION_KEY__
DOCUMENSO_ENCRYPTION_SECONDARY_KEY=__DOCUMENSO_ENCRYPTION_SECONDARY_KEY__
DOCUMENSO_SIGNING_PASSPHRASE=__DOCUMENSO_SIGNING_PASSPHRASE__
DOCUMENSO_WEBHOOK_SECRET=__DOCUMENSO_WEBHOOK_SECRET__
# Nach dem ersten Login in Documenso einen API-Token anlegen und hier eintragen
# Leer lassen = automatische Einrichtung beim Start (Konto der Geschäftsführung, Team, API-Token, Webhook)
DOCUMENSO_API_TOKEN=
# Nach Anlage der eigenen Konten auf true setzen
DOCUMENSO_DISABLE_SIGNUP=false
# Mailversand von Documenso über Workspace: Postfach + App-Passwort (Documenso unterstützt kein OAuth für SMTP)
DOCUMENSO_SMTP_USERNAME=
DOCUMENSO_SMTP_APP_PASSWORD=
DOCUMENSO_SMTP_FROM_NAME=Signatur
# Optional: Google-Anmeldung in Documenso (eigener OAuth-Client)
DOCUMENSO_GOOGLE_CLIENT_ID=
DOCUMENSO_GOOGLE_CLIENT_SECRET=

# NUR LOKAL: Anmeldung ohne Google für Browsertests. In Produktion verboten (Start schlägt fehl).
DEV_LOGIN_ENABLED=false

# ── KI für Belegerkennung + Kontierung (nur auf Klick bzw. Belegpostfach) ──
# Lokale KI ist eingebaut (Dienst "ollama"): Qwen 2.5 VL wird beim ersten Start automatisch geladen.
# AI_PROVIDER=none schaltet die KI ab. OLLAMA_URL leer = eingebauter Dienst (http://ollama:11434).
AI_PROVIDER=auto
OLLAMA_URL=
# qwen2.5vl:7b (beste Qualität, ≥ 12 GB RAM) oder qwen2.5vl:3b (für Rechner/Server mit 8 GB)
OLLAMA_MODEL=qwen2.5vl:7b
OLLAMA_IMAGE=ollama/ollama:0.12.6
# Alternativ Claude (Anthropic-API) – vorher AVV/DPA abschließen
ANTHROPIC_API_KEY=
EXTRACTION_MODEL=claude-opus-5-5

# ── Bank ──
# Onlinebanking (FinTS/HBCI): registrierte Produkt-ID der Deutschen Kreditwirtschaft (Antrag: fints.org)
FINTS_PRODUCT_ID=

# ── Datensicherung ──
BACKUP_HOUR=2
BACKUP_PATH=./backups
# Archiv-Spiegelung auf Festplatte/NAS (Ziel „Ordner“ unter Archiv → Spiegelung); z. B. /mnt/usb-archiv
ARCHIVE_EXPORT_PATH=./exports

# ── Firma & ELSTER ──
# Bundesland des Firmensitzes (für Steuernummer im ELSTER-Format) und Gewerbesteuer-Hebesatz der Gemeinde
COMPANY_STATE=NW
TRADE_TAX_MULTIPLIER=440
# ELSTER-Übertragung der Umsatzsteuer-Voranmeldung: Registrierung unter https://www.elster.de/elsterweb/entwickler
# ERiC-Verzeichnis nach secrets/eric kopieren, Organisationszertifikat als secrets/elster.pfx ablegen
ELSTER_HERSTELLER_ID=
# true = mit Testmerker (Finanzamt verarbeitet nicht) – erst nach erfolgreichem Test auf false setzen
ELSTER_TEST_MODE=true
# E-Mail des Documenso-Kontos (leer = erste Person mit Rolle Geschäftsführung)
DOCUMENSO_ADMIN_EMAIL=
